# ============================================================
# Paradox-DB Production Environment Variables
# Copy this file to .env and fill in all required values
# ============================================================

# --- Telegram (REQUIRED) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- PostgreSQL (REQUIRED) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Authentication (REQUIRED — generate random values) ---
JWT_SECRET=
API_KEY_SALT=

# --- Rate Limits & Uploads ---
MAX_UPLOAD_SIZE_MB=50
RATE_LIMIT_UPLOADS_PER_MINUTE=15
LOCK_TIMEOUT_SECONDS=30

# --- Domain (for TLS) ---
# DOMAIN=your-domain.com
# LETSENCRYPT_EMAIL=you@your-domain.com
