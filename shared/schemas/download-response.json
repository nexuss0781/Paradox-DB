{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DownloadResponse",
  "description": "Schema for GET /v1/versions response (200)",
  "type": "object",
  "required": ["database_name", "versions"],
  "properties": {
    "database_name": {
      "type": "string",
      "description": "Name of the database"
    },
    "versions": {
      "type": "array",
      "description": "List of available versions, newest first",
      "items": {
        "type": "object",
        "required": ["version", "message_id", "uploaded_at", "size_bytes"],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1,
            "description": "Version number"
          },
          "message_id": {
            "type": "string",
            "description": "Telegram message ID for this version"
          },
          "uploaded_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of upload"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "description": "File size in bytes"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
