# ============================================================
# Paradox-DB Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# --- Telegram ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# API credentials from https://my.telegram.org
TELEGRAM_API_ID=12345
TELEGRAM_API_HASH=abcdef1234567890

# --- Registry Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/paradox_registry

# --- Redis (distributed locks) ---
REDIS_URL=redis://localhost:6379/0

# --- Authentication ---
# Secret key for JWT token signing (change in production)
JWT_SECRET=your-secret-key-here
# Salt for API key hashing (change in production)
API_KEY_SALT=your-salt-here

# --- Rate Limits & Locks ---
# Maximum upload file size in MB (Telegram Bot API limit: 50, Telethon: 2048)
MAX_UPLOAD_SIZE_MB=50
# Maximum uploads per minute per channel (Telegram limit: ~20)
RATE_LIMIT_UPLOADS_PER_MINUTE=15
# Timeout in seconds for acquiring distributed lock per database
LOCK_TIMEOUT_SECONDS=30
