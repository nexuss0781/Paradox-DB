# ============================================================
# Gateway Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_API_ID=12345
TELEGRAM_API_HASH=abcdef1234567890
TELEGRAM_STORAGE_CHAT_ID=1896903088

# --- Registry Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/paradox_registry

# Version-writer locks use transaction-scoped PostgreSQL advisory locks.

# --- Authentication ---
JWT_SECRET=your-secret-key-here
API_KEY_SALT=your-salt-here
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATABASE_URL_ENCRYPTION_KEY=your-fernet-key-here

# New Nexuss exchanges/handoffs only; leave disabled until readiness approval.
PARADOX_ENVX_ONLY_AUTH_ENABLED=false
ENVX_OIDC_ISSUER_URL=
# Existing Nexuss Auth production endpoint and the configured Paradox project id.
NEXUSS_AUTH_URL=https://nexuss-auth.vercel.app
NEXUSS_AUTH_PROJECT_ID=
# Exact HTTPS callback registered in the Nexuss Auth project (never derive from Host).
PARADOX_AUTH_CALLBACK_URL=https://paradox-db.wasmer.app/v1/auth/nexuss/callback

# --- Rate Limits & Locks ---
MAX_UPLOAD_SIZE_MB=50
RATE_LIMIT_UPLOADS_PER_MINUTE=15
LOCK_TIMEOUT_SECONDS=30
